    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.id, s.student_id, st.name AS student_name, s.day_of_week, s.start_time, s.duration_minutes,\n  s.recurrence_type, s.start_date, s.recurrence_group_id\nFROM teachers_manager.schedules s\nJOIN teachers_manager.students st ON s.student_id = st.id\nWHERE s.teacher_id = $1\nORDER BY s.day_of_week, s.start_time;",
        "options": {
          "queryReplacement": "={{ $json.teacherId }}"
        }
