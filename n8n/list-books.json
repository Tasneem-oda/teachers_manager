        160
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  b.id, b.title, b.file_name, b.file_type, b.storage_path, b.status, b.error_message,\n  b.progress, b.is_scanned, b.ocr_page_count,\n  b.page_count, b.chapter_count, b.chapters, b.created_at, b.updated_at,\n  COALESCE(\n    (SELECT json_agg(l.student_id) FROM teachers_manager.book_student_links l WHERE l.book_id = b.id),\n    '[]'::json\n  ) AS student_ids\nFROM teachers_manager.book_sources b\nWHERE b.teacher_id = $1::uuid\nORDER BY b.created_at DESC;",
        "options": {
          "queryReplacement": "={{ $json.teacherId }}"
        }
      },
