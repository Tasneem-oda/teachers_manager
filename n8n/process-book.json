        "query": "WITH upd AS (\n  UPDATE teachers_manager.book_sources\n  SET status = 'processing', progress = 0, error_message = NULL,\n      is_scanned = false, ocr_page_count = 0, updated_at = now()\n  WHERE id = $1::uuid AND teacher_id = $2::uuid\n    AND NOT (status = 'processing' AND updated_at > now() - interval '2 minutes')\n  RETURNING id, title, file_type, status\n), del AS (\n  DELETE FROM teachers_manager.book_chunks WHERE book_id IN (SELECT id FROM upd)\n)\nSELECT id, title, file_type, status FROM upd;",
