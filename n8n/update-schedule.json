        "query": "SELECT\n  EXISTS(SELECT 1 FROM teachers_manager.schedules WHERE id = $1::uuid AND teacher_id = $2::uuid) AS schedule_owned,\n  (SELECT COUNT(*) FROM teachers_manager.schedules\n    WHERE teacher_id = $2::uuid AND day_of_week = $3::integer\n    AND (start_time, start_time + ($4::integer || ' minutes')::interval)\n        OVERLAPS ($5::time, $5::time + ($4::integer || ' minutes')::interval)\n    AND id::text <> $1::text\n  ) AS conflict_count;",
        "options": {
