        {
            "parameters": {
                "jsCode": "// نقسّم النتيجة إلى غير مقروءة / مقروءة عشان الواجهة تعرضهم في تبويبين\n// مباشرة من غير ما تحتاج تفلتر بنفسها\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nconst unread = rows.filter(r => r.is_read === false);\nconst read = rows.filter(r => r.is_read === true);\nreturn { unread, read };"
