                "operation": "executeQuery",
                "query": "SELECT id, title, body, url, is_read, created_at, read_at\nFROM teachers_manager.notifications\nWHERE teacher_id = $1::uuid\nORDER BY created_at DESC\nLIMIT 200;",
                "options": {
                    "queryReplacement": "={{ $json.teacherId }}"
